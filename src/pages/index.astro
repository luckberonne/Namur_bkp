---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';

const metadata = {
  title: 'Namur — Soluciones Agropecuarias',
  description: 'Descubre Namur, tu socio ideal para soluciones agropecuarias. Ofrecemos productos agrícolas, asesoría técnica para maximizar la productividad y eficiencia.',
  keywords: 'Namur, soluciones agropecuarias, productos agrícolas, plantillas web, Astro, Tailwind CSS, asesoría técnica, eficiencia agrícola',
};

---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Productos',
        href: 'https://github.com/onwidget/namur',
        target: '_blank',
        icon: 'tabler:click',
      },
      { text: 'Contactenos', href: '#features' },
    ]}
  >
    <Fragment slot="title">
      Venta y asesoria <span class="hidden xl:inline">de productos agricolas</span>
      <span class="text-accent dark:text-white highlight"> Namur</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Namur</span> es una empresa dedicada a la venta de productos agrícolas, tanto alimenticios
        como bioquímicos. Ofrece semillas, fertilizantes, pesticidas y soluciones de manejo de cultivos, enfocándose en la
        productividad y la sostenibilidad. Además, brinda asesoría técnica para optimizar los resultados de sus clientes
        en el campo.</span
      >
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Características"
    title="Lo que obtienes con Namur"
    subtitle="Una de las soluciones agrícolas más profesionales y completas del mercado. Reconocida por su enfoque en calidad y sostenibilidad en 2022."
    items={[
      {
        title: 'Integración Agroquímica y Alimentaria',
        description:
          'Una integración fluida entre productos alimenticios y bioquímicos que ofrece alta productividad, rendimiento y versatilidad en la agricultura.',
        icon: 'tabler:world-upload',
      },
      {
        title: 'Componentes Listos para Usar',
        description:
          'Productos agrícolas listos para ser utilizados en cultivos comerciales, orgánicos, y pequeños negocios rurales.',
        icon: 'tabler:components',
      },
      {
        title: 'Mejores Prácticas',
        description:
          'Implementando técnicas seguras, eficientes y amigables con el medio ambiente, garantizando una producción sostenible y de alto valor.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Excelente Productividad',
        description:
          'Mantener una alta productividad impacta positivamente en la rentabilidad del campo, mejora la calidad de los cultivos y aumenta la competitividad.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Optimización de Rendimiento',
        description:
          'Mejorar el rendimiento de los cultivos es clave para aumentar la producción y aprovechar al máximo los recursos disponibles.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Abiertos a Nuevas Ideas y Colaboraciones',
        description:
          'Adoptando una cultura abierta a nuevas ideas y colaboraciones, lo cual es fundamental para fomentar la innovación y un servicio dinámico al cliente.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="¡El Modelo de Namur: Mejora y Funcionalidad!"
    title="Obtén una ventaja competitiva en la industria."
    items={[
      {
        title: 'Desarrollado con Innovación Agrícola',
        description:
          'Beneficiándote de las últimas tecnologías y enfoques en agricultura para maximizar el rendimiento y la eficiencia.',
      },
      {
        title: 'Estilizado con Sostenibilidad',
        description:
          'Facilitando un crecimiento rápido y uniforme con prácticas agrícolas sostenibles y respetuosas con el medio ambiente.',
      },
      {
        title: 'Compatibilidad Multiterreno',
        description:
          'Asegura que tus cultivos se desarrollen de manera consistente en diversas condiciones, brindando una experiencia óptima en cualquier entorno agrícola.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1527153857715-3908f2bae5e8?q=80&w=1388&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Construyendo sobre bases modernas
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Alto nivel de personalización',
        description: `Adapta fácilmente nuestras soluciones agrícolas para que coincidan con la identidad y necesidades de tu marca, haciendo que tu propuesta sea única y ahorrando tiempo.`,
      },
      {
        title: 'Múltiples posibilidades de configuración',
        description:
          'Explora diversas opciones de configuración para encontrar la estructura que mejor presente tus productos, mejorando la interacción y navegación del cliente.',
      },
      {
        title: 'Diseño completamente adaptable',
        description:
          'Asegura un rendimiento óptimo de tus productos en diferentes entornos y condiciones, ofreciendo una experiencia agrícola consistente y eficiente.',
      },
      {
        title: 'Integración de productos en tu campo',
        description:
          'Incorpora de la mejor manera nuestros productos en tu campo para mejorar la productividad y la rentabilidad.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1658996685337-3bd109a46605?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Njd8fGFncm9wZWN1YXJpb3xlbnwwfHwwfHx8MA%3D%3D',
      alt: 'Imagen de plano de trabajo',
    }}
  >
    <Fragment slot="content"></Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <!-- Steps Widget ****************** -->

  <Steps
    title="Obtén los productos agropecuarios que necesitas con Namur de manera rápida y sencilla."
    items={[
      {
        title: 'Paso 1: <span class="font-medium">Selecciona tus productos</span>',
        description:
          'Explora nuestro catálogo en línea y elige los productos agropecuarios que mejor se adapten a tus necesidades. Desde semillas hasta bioquímicos, encuentra todo lo que necesitas para tu campo.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Paso 2: <span class="font-medium">Personaliza tu pedido</span>',
        description:
          'Configura la cantidad y especificaciones de los productos que has seleccionado. Ajusta tu pedido para asegurarte de que estás recibiendo exactamente lo que necesitas para optimizar tu producción.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Paso 3: <span class="font-medium">Realiza tu compra</span>',
        description:
          'Confirma tu pedido y elige el método de pago que más te convenga. Namur se encargará de que tus productos lleguen a tiempo y en perfectas condiciones para que puedas comenzar a utilizarlos de inmediato.',
        icon: 'tabler:credit-card',
      },
      {
        title: '¡Listo!',
        description:
          'Tus productos están en camino, y tu campo está a punto de recibir lo mejor que Namur tiene para ofrecer.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Imagen de pasos agropecuarios',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas Frecuentes"
    subtitle="Explora las siguientes preguntas para obtener información sobre las potentes características que Namur ofrece y cómo puede optimizar tus operaciones agrícolas."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Por qué elegir Namur?',
        description:
          'Namur ofrece soluciones integrales para tus necesidades agropecuarias, desde semillas y fertilizantes hasta productos bioquímicos. Nos destacamos por nuestra calidad, sostenibilidad y servicio al cliente, ayudando a mejorar la productividad y eficiencia en el campo.',
      },
      {
        title: '¿Qué necesito para comenzar?',
        description:
          'Para empezar con Namur, solo necesitas acceso a internet para explorar nuestro catálogo en línea. Elige los productos que mejor se adapten a tus necesidades agrícolas y configúralos según tus requerimientos específicos.',
      },
      {
        title: '¿Cómo se realiza un pedido con Namur?',
        description:
          'Es fácil. Simplemente selecciona los productos que deseas, personaliza tu pedido según tus necesidades, y completa la compra a través de nuestro sitio web. Te proporcionaremos actualizaciones y detalles de envío para asegurar una entrega puntual.',
      },
      {
        title: '¿Qué hacer si tengo problemas con un producto?',
        description:
          'Si encuentras algún problema con un producto, por favor, contáctanos a través de nuestro servicio de atención al cliente. Estamos aquí para ayudarte a resolver cualquier inconveniente y asegurar que estés satisfecho con tu compra.',
      },
      {
        title: '¿Namur ofrece asesoría técnica?',
        description:
          'Sí, ofrecemos asesoría técnica para ayudarte a elegir los productos adecuados y aplicarlos de manera efectiva en tus cultivos. Nuestro equipo de expertos está disponible para brindarte soporte y recomendaciones personalizadas.',
      },
      {
        title: '¿Qué formas de pago acepta Namur?',
        description:
          'Aceptamos varias formas de pago para tu conveniencia, incluyendo tarjetas de crédito, débito y transferencias bancarias. Elige el método que mejor se adapte a tus necesidades al momento de realizar tu compra.',
      },
    ]}
  />
    <Stats
      stats={[
        { title: 'Empresas que confían en nosotros', amount: '132' },
        { title: 'Proyectos exitosos', amount: '24.8K' },
        { title: 'Productos entregados', amount: '10.3K' },
        { title: 'Clientes satisfechos', amount: '48.4K' },
      ]}
    />
</Layout>
