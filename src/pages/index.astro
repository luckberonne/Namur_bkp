---
import Layout from '~/layouts/PageLayout.astro';
import agro from '~/assets/videos/agro.mp4';
import varias from '~/assets/images/general/varias.jpg';
import varias1 from '~/assets/images/general/varias1.jpg';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import { getLocaleFromUrl, useTranslations } from '~/i18n/translator';

const { t } = useTranslations(getLocaleFromUrl(Astro.url));
 
const metadata = {
  title: t('index.metadata.title'),
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  video={agro}
  >
    <Fragment slot="title">
      {t('index.hero.title.part1')} <span class="hidden xl:inline"></span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        {t('index.hero.presubtitle')}<span class="font-semibold">Namur </span>{t('index.hero.subtitle')}</span
      >
    </Fragment>
  </Hero>

  <Content
    isReversed
    title={t('index.howWeWork.title')}
    items={[
      {
        title: t('index.howWeWork.bpa'),
        description:t('index.howWeWork.bpadescription'),
      },
      {
        title: t('index.howWeWork.fairtrade'),
        description:t('index.howWeWork.fairtradedescription'),
      },
      {
        title: t('index.howWeWork.gap'),
        description:t('index.howWeWork.gapdescription'),
      },
    ]}
    image={{
      src: varias,
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        {t('index.howWeWork.subtitle')}
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Alto nivel de personalización',
        description: `Adapta fácilmente nuestras soluciones agrícolas para que coincidan con la identidad y necesidades de tu marca, haciendo que tu propuesta sea única y ahorrando tiempo.`,
      },
      {
        title: 'Múltiples posibilidades de configuración',
        description:
          'Explora diversas opciones de configuración para encontrar la estructura que mejor presente tus productos, mejorando la interacción y navegación del cliente.',
      },
      {
        title: 'Diseño completamente adaptable',
        description:
          'Asegura un rendimiento óptimo de tus productos en diferentes entornos y condiciones, ofreciendo una experiencia agrícola consistente y eficiente.',
      },
      {
        title: 'Integración de productos en tu campo',
        description:
          'Incorpora de la mejor manera nuestros productos en tu campo para mejorar la productividad y la rentabilidad.',
      },
    ]}
    image={{
      src: varias1,
      alt: 'Imagen de plano de trabajo',
    }}
  >
    <Fragment slot="content"></Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- FAQs Widget ******************* -->

  <FAQs
    title={t('index.questions.title')}
    subtitle={t('index.questions.subtitle')}

    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: t('index.questions.ask.first'),
        description: t('index.questions.ask.answerFirst'),
      },
      {
        title: t('index.questions.ask.second'),
        description: t('index.questions.ask.answerSecond'),
      },
      {
        title: t('index.questions.ask.third'),
        description: t('index.questions.ask.answerThird'),  
      },
      {
        title: t('index.questions.ask.fourth'),
        description: t('index.questions.ask.answerFourth'),  
      },
      {
        title: t('index.questions.ask.fifth'),
        description: t('index.questions.ask.answerFifth'),  
      },
      {
        title: t('index.questions.ask.sixth'),
        description: t('index.questions.ask.answerSixth'),  
      },
    ]}
  />
    <Stats
      stats={[
        { title: t('index.statsIndex.a'), amount: '132' },
        { title: t('index.statsIndex.b'), amount: '+20' },
        { title: t('index.statsIndex.c'), amount: '+300T' },
      ]}
    />
</Layout>
