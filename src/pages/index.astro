---
import Layout from '~/layouts/PageLayout.astro';
import agro from '~/assets/videos/agro.webm';
import varias from '~/assets/images/general/varias.jpg';
import varias1 from '~/assets/images/general/varias1.jpg';


import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import { getLocaleFromUrl, useTranslations } from '~/i18n/translator';

const { t } = useTranslations(getLocaleFromUrl(Astro.url));

const metadata = {
  title: t('index.metadata.title'),
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  video={agro}
  >
    <Fragment slot="title">
      {t('index.hero.title.part1')} <span class="hidden xl:inline">{t('index.hero.title.part2')}</span>
      <span class="text-accent dark:text-white highlight"> Namur</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Namur </span>{t('index.hero.subtitle')}</span
      >
    </Fragment>
  </Hero>

  <Content
    isReversed
    title="Conoce nuestra forma de trabajar."
    items={[
      {
        title: 'Certificación BPA',
        description:
          'Las BPA son un conjunto de prácticas que buscan optimizar la producción agrícola, minimizando el impacto ambiental y asegurando la inocuidad de los alimentos.',
      },
      {
        title: 'Certificación Fairtrade',
        description:
          'Fairtrade garantiza que los productores reciben un precio justo por sus productos y trabajan en condiciones laborales adecuadas.',
      },
      {
        title: 'Certifiación GlobalGAP',
        description:
          'GlobalGAP es un estándar internacional que asegura que los productos agrícolas se producen de manera segura y responsable, cumpliendo con requisitos ambientales y sociales.',
      },
    ]}
    image={{
      src: varias,
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Construyendo sobre bases modernas
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Alto nivel de personalización',
        description: `Adapta fácilmente nuestras soluciones agrícolas para que coincidan con la identidad y necesidades de tu marca, haciendo que tu propuesta sea única y ahorrando tiempo.`,
      },
      {
        title: 'Múltiples posibilidades de configuración',
        description:
          'Explora diversas opciones de configuración para encontrar la estructura que mejor presente tus productos, mejorando la interacción y navegación del cliente.',
      },
      {
        title: 'Diseño completamente adaptable',
        description:
          'Asegura un rendimiento óptimo de tus productos en diferentes entornos y condiciones, ofreciendo una experiencia agrícola consistente y eficiente.',
      },
      {
        title: 'Integración de productos en tu campo',
        description:
          'Incorpora de la mejor manera nuestros productos en tu campo para mejorar la productividad y la rentabilidad.',
      },
    ]}
    image={{
      src: varias1,
      alt: 'Imagen de plano de trabajo',
    }}
  >
    <Fragment slot="content"></Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas Frecuentes"
    subtitle="Explora las siguientes preguntas para obtener información sobre las potentes características que Namur ofrece y cómo puede optimizar tus operaciones agrícolas."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Por qué elegir Namur?',
        description:
          'Namur ofrece soluciones integrales para tus necesidades agropecuarias, desde semillas y fertilizantes hasta productos bioquímicos. Nos destacamos por nuestra calidad, sostenibilidad y servicio al cliente, ayudando a mejorar la productividad y eficiencia en el campo.',
      },
      {
        title: '¿Qué necesito para comenzar?',
        description:
          'Para empezar con Namur, solo necesitas acceso a internet para explorar nuestro catálogo en línea. Elige los productos que mejor se adapten a tus necesidades agrícolas y configúralos según tus requerimientos específicos.',
      },
      {
        title: '¿Cómo se realiza un pedido con Namur?',
        description:
          'Es fácil. Simplemente selecciona los productos que deseas, personaliza tu pedido según tus necesidades, y completa la compra a través de nuestro sitio web. Te proporcionaremos actualizaciones y detalles de envío para asegurar una entrega puntual.',
      },
      {
        title: '¿Qué hacer si tengo problemas con un producto?',
        description:
          'Si encuentras algún problema con un producto, por favor, contáctanos a través de nuestro servicio de atención al cliente. Estamos aquí para ayudarte a resolver cualquier inconveniente y asegurar que estés satisfecho con tu compra.',
      },
      {
        title: '¿Namur ofrece asesoría técnica?',
        description:
          'Sí, ofrecemos asesoría técnica para ayudarte a elegir los productos adecuados y aplicarlos de manera efectiva en tus cultivos. Nuestro equipo de expertos está disponible para brindarte soporte y recomendaciones personalizadas.',
      },
      {
        title: '¿Qué formas de pago acepta Namur?',
        description:
          'Aceptamos varias formas de pago para tu conveniencia, incluyendo tarjetas de crédito, débito y transferencias bancarias. Elige el método que mejor se adapte a tus necesidades al momento de realizar tu compra.',
      },
    ]}
  />
    <Stats
      stats={[
        { title: 'Empresas que confían en nosotros', amount: '132' },
        { title: 'Proyectos exitosos', amount: '24.8K' },
        { title: 'Productos entregados', amount: '10.3K' },
        { title: 'Clientes satisfechos', amount: '48.4K' },
      ]}
    />
</Layout>
