---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Precios"
    title="Consultoría en aspectos regulatorios"
    subtitle="Elige el plan perfecto que se alinee con tus objetivos en el sector agropecuario."
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="Nuestros precios"
    subtitle="Solo paga por lo que necesitas"
    prices={[
      {
        title: 'Básico',
        subtitle: 'Opción óptima para pequeños productores',
        price: 29,
        period: 'por mes',
        items: [
          {
            description: 'Acceso a informes básicos',
          },
          {
            description: 'Soporte a través de correo electrónico',
          },
          {
            description: 'Integración básica con sistemas de gestión',
          },
          {
            description: 'Consultoría limitada',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Comenzar ahora',
          href: '#',
        },
      },
      {
        title: 'Estándar',
        subtitle: 'Ideal para medianas empresas agrícolas',
        price: 69,
        period: 'por mes',
        items: [
          {
            description: 'Acceso a informes avanzados',
          },
          {
            description: 'Soporte a través de chat y correo electrónico',
          },
          {
            description: 'Integración avanzada con sistemas de gestión',
          },
          {
            description: 'Consultoría personalizada',
          },
          {
            description: 'Acceso a seminarios web exclusivos',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Comenzar ahora',
          href: '#',
        },
        hasRibbon: true,
        ribbonTitle: 'popular',
      },
      {
        title: 'Premium',
        subtitle: 'Opción óptima para grandes corporaciones',
        price: 199,
        period: 'por mes',
        items: [
          {
            description: 'Acceso a informes personalizados',
          },
          {
            description: 'Soporte dedicado 24/7',
          },
          {
            description: 'Integración completa con sistemas empresariales',
          },
          {
            description: 'Consultoría estratégica continua',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Comenzar ahora',
          href: '#',
        },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Características relacionadas con los precios"
    subtitle="Descubre las ventajas de elegir nuestros planes"
    columns={2}
    items={[
      {
        title: 'Planes por niveles',
        description: 'Elige entre una gama de planes diseñados para acomodar diferentes presupuestos y necesidades.',
        icon: 'tabler:stairs',
      },
      {
        title: 'Precios Transparentes',
        description:
          'Detalles de precios claramente mostrados para cada plan, sin costos ocultos ni cargos inesperados.',
        icon: 'tabler:flip-vertical',
      },
      {
        title: 'Métodos de Pago Seguros',
        description: 'Pasarelas de pago seguras para proteger tu información financiera durante las transacciones.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Acceso Instantáneo',
        description: `Acceso inmediato a las características y productos del plan elegido tras la suscripción.`,
        icon: 'tabler:accessible',
      },
      {
        title: 'Valor de Actualización',
        description:
          'Actualiza a planes de nivel superior para desbloquear más funciones y beneficios para una experiencia mejorada.',
        icon: 'tabler:chevrons-up',
      },
      {
        title: 'Soporte 24H',
        description:
          'Resuelve tus dudas a través de chat en vivo, correo electrónico o teléfono, todos los días del año.',
        icon: 'tabler:headset',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Un viaje guiado desde la selección de planes hasta el éxito"
    tagline="Proceso simplificado"
    isReversed={true}
    items={[
      {
        title: 'Explora los planes',
        icon: 'tabler:number-1',
      },
      {
        title: 'Selecciona un plan',
        icon: 'tabler:number-2',
      },
      {
        title: 'Regístrate / Inicia sesión',
        icon: 'tabler:number-3',
      },
      {
        title: 'Revisa el pedido',
        icon: 'tabler:number-4',
      },
      {
        title: 'Introduce los datos de pago',
        icon: 'tabler:number-5',
      },
      {
        title: 'Confirmación',
        icon: 'tabler:number-6',
      },
      {
        title: 'Descarga y comienza a usar los productos',
        icon: 'tabler:number-7',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1536816579748-4ecb3f03d72a?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Imagen del proceso',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas Frecuentes sobre los Precios"
    subtitle="Elegir el plan adecuado es importante, y estamos aquí para responder tus preguntas. Si tienes dudas sobre nuestras opciones de precios, estás en el lugar correcto."
    columns={1}
    items={[
      {
        title: '¿Los planes incluyen soporte al cliente?',
        description:
          'Absolutamente, todos los planes incluyen acceso a nuestro soporte dedicado para asistirte con cualquier duda o inquietud.',
      },
      {
        title: '¿Hay un periodo de prueba para los diferentes planes?',
        description:
          'Desafortunadamente, no ofrecemos periodos de prueba para los planes. Sin embargo, puedes revisar nuestra sección de demostraciones para ver la calidad de nuestros productos.',
      },
      {
        title: '¿Puedo cambiar de plan?',
        description:
          '¡Por supuesto! Puedes actualizar o degradar tu plan fácilmente, en cualquier momento, para encontrar el que mejor se adapte a tus necesidades.',
      },
      {
        title: '¿Qué métodos de pago aceptan?',
        description:
          'Aceptamos tarjetas de crédito principales y métodos de pago en línea para garantizar un proceso de transacción conveniente y seguro.',
      },
      {
        title: '¿Existen tarifas ocultas además del costo mostrado?',
        description:
          'No, el costo de la suscripción cubre todas las funciones y productos enumerados en cada plan. No hay tarifas ocultas ni cargos adicionales.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="¿Listo para mejorar tus proyectos?"
    subtitle="Únete a nuestra comunidad de clientes satisfechos que han transformado su trabajo con nuestros productos."
    actions={[
      {
        variant: 'primary',
        text: 'Comienza ahora',
        href: '/',
      },
    ]}
  />
</Layout>
