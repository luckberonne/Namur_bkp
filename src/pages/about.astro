---
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import agro1 from '~/assets/videos/agro1.webm';
import { getLocaleFromUrl, useTranslations } from '~/i18n/translator';

const { t } = useTranslations(getLocaleFromUrl(Astro.url));

const metadata = {
  title: 'About us',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    video={agro1}
    
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title">
      {t('aboutUs.title')} <br />
      <span class="text-accent dark:text-white highlight"></span>
    </Fragment>

    <Fragment slot="subtitle">
      {t('aboutUs.subtitle')}
    </Fragment>
  </Hero>

  <Features3
    title={t('aboutUs.mision.title')}
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: t('aboutUs.mision.itemA'),
        description:
        t('aboutUs.mision.descriptionA'),
      },
      {
        title: t('aboutUs.mision.itemB'),
        description:
        t('aboutUs.mision.descriptionB'),
      },
      {
        title: t('aboutUs.mision.itemC'),
        description:
        t('aboutUs.mision.descriptionC'),
      },
    ]}
  />

  <Features3
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Colorful Image',
    }}
  />

  <Steps2
    title={t('aboutUs.values.title')}
    subtitle={t('aboutUs.values.subtitle')}
    items={[
      {
        title: 'Compromiso',
        description:
          'Trabajamos con dedicación para garantizar la calidad en cada etapa del proceso.',
      },
      {
        title: 'Confianza',
        description:
          'Relaciones transparentes y duraderas con nuestros clientes y productores.',
      },
      {
        title: 'Amor por la naturaleza',
        description:
          'Respetamos y promovemos',
      },
    ]}
  />

  <Steps2
    title="Achievements"
    subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi sagittis, quam nec venenatis lobortis, mi risus tempus nulla, sed porttitor est nibh at nulla."
    isReversed={true}
    items={[
      {
        title: 'Global reach',
        description: 'Nam malesuada urna in enim imperdiet tincidunt. Phasellus non tincidunt nisi, at elementum mi.',
        icon: 'tabler:globe',
      },
      {
        title: 'Positive customer feedback and reviews',
        description:
          'Cras semper nulla leo, eget laoreet erat cursus sed. Praesent faucibus massa in purus iaculis dictum.',
        icon: 'tabler:message-star',
      },
      {
        title: 'Awards and recognition as industry experts',
        description:
          'Phasellus lacinia cursus velit, eu malesuada magna pretium eu. Etiam aliquet tellus purus, blandit lobortis ex rhoncus vitae.',
        icon: 'tabler:award',
      },
    ]}
  />
</Layout>
