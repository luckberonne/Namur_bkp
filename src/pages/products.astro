---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getLocaleFromUrl, useTranslations } from '~/i18n/translator';

const { t } = useTranslations(getLocaleFromUrl(Astro.url));

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  tagline="Productos alimenticios"
  title="Impulsa tu producción con nuestras soluciones agropecuarias"
  subtitle="Explora nuestros productos cuidadosamente seleccionados para optimizar cada aspecto de tu operación agrícola. Desde insumos de alta calidad hasta herramientas digitales, te ofrecemos todo lo necesario para alcanzar el éxito en el campo."
  actions={[{ variant: 'primary', target: '_blank', text: 'Comienza a explorar', href: '/' }]}
/>

  <!-- Features2 Widget ************** -->

  <Features2
  title="Explora nuestras soluciones agropecuarias"
  subtitle="Descubre nuestra selección de productos y servicios diseñados para optimizar cada aspecto de tu operación agrícola."
  columns={3}
  items={[
    {
      title: 'Oregano',
      description:
        'Ofrecemos una variedad de semillas, fertilizantes y productos fitosanitarios de alta calidad para mejorar la productividad de tus cultivos.',
      icon: 'tabler:plant',
    },
    {
      title: 'Lino ',
      description:
        'Incorpora la última tecnología en tu campo con nuestras herramientas y dispositivos diseñados para mejorar la eficiencia y la precisión en la producción agrícola.',
      icon: 'tabler:device-desktop-analytics',
    },
    {
      title: 'Pasa de uva ',
      description: `Nuestro equipo de expertos está disponible para brindarte orientación personalizada y soluciones adaptadas a las necesidades específicas de tu operación.`,
      icon: 'tabler:headset',
    },
    {
      title: 'Chia ',
      description:
        'Optimiza el uso del agua con nuestros sistemas de riego eficientes y sostenibles, diseñados para maximizar el rendimiento de tus cultivos.',
      icon: 'tabler:droplet',
    },
    {
      title: 'Sesamo ',
      description:
        'Aprovecha nuestros productos orgánicos para promover prácticas agrícolas sostenibles y obtener certificaciones ecológicas.',
      icon: 'tabler:leaf',
    },
    {
      title: 'Coriandro ',
      description:
        'Equipos de última generación que facilitan y agilizan las tareas en el campo, desde la siembra hasta la cosecha.',
      icon: 'tabler:tractor',
    },
    {
      title: 'Albahaca',
      description:
        'Sistemas integrados para la planificación y monitoreo de cultivos, ayudando a maximizar el rendimiento y minimizar los riesgos.',
      icon: 'tabler:chart-line',
    },
    {
      title: 'Romero',
      description: `Te ayudamos a implementar prácticas agrícolas sostenibles que respetan el medio ambiente y mejoran la rentabilidad a largo plazo.`,
      icon: 'tabler:recycle',
    }
  ]}
/>

  
</Layout>
