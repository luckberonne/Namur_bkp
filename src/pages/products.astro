---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getLocaleFromUrl, useTranslations } from '~/i18n/translator';
import p1 from '~/assets/images/products/p1-oregano.jpg';
import p2 from '~/assets/images/products/p2-lino.jpg';
import p3 from '~/assets/images/products/p3-pasa-de-uva.jpg';
import p4 from '~/assets/images/products/p4-coriandro.jpg';
import p5 from '~/assets/images/products/p5-romero.jpg';
import p6 from '~/assets/images/products/p6-ajo-en-polvo.jpg';
import p7 from '~/assets/images/products/N-de-Namur.png';

import mainImage from '~/assets/images/general/mainProd.jpg';



const { t } = useTranslations(getLocaleFromUrl(Astro.url));

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  title={t('products.title')}
  subtitle={t('products.subtitle')}  actions={[{ variant: 'primary', target: '_blank', text: 'Comienza a explorar', href: '/' }]}
  image={{
    src: mainImage,
    alt: 'Product',
  }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
  title={t('products.grillaProd.title')}
  subtitle={t('products.grillaProd.subtitle')}
  columns={3}
  items={[
    {
      title: t('products.grillaProd.oregano.title'),
      description: t('products.grillaProd.oregano.description'),
      image: p1
    },
    {
      title: t('products.grillaProd.lino.title'),
      description:t('products.grillaProd.lino.description'),
      image: p2

    },
    {
      title: t('products.grillaProd.pasaDeUva.title'),
      description:t('products.grillaProd.pasaDeUva.description'),
      image: p3

    },
    {
      title: t('products.grillaProd.coriandro.title'),
      description:t('products.grillaProd.coriandro.description'),
      image: p4

    },
    {
      title: t('products.grillaProd.romero.title'),
      description:t('products.grillaProd.romero.description'),
      image: p5

    },
    {
      title: t('products.grillaProd.ajoEnPolvo.title'),
      description:t('products.grillaProd.ajoEnPolvo.description'),
      image: p6

    },
    {
      title: t('products.grillaProd.albahaca.title'),
      description:t('products.grillaProd.albahaca.description'),
      image: p7

    },
    {
      title: t('products.grillaProd.sesamo.title'),
      description:t('products.grillaProd.sesamo.description'),
      image: p7

    },
    {
      title: t('products.grillaProd.proximamente.title'),
      description: t('products.grillaProd.proximamente.description'),
      image: p7

    }
  ]}
/>

  
</Layout>
