---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getLocaleFromUrl, useTranslations } from '~/i18n/translator';
import p1 from '~/assets/images/products/p1-oregano.jpg';
import p2 from '~/assets/images/products/p2-lino.jpg';
import p3 from '~/assets/images/products/p3-pasa-de-uva.jpg';
import p4 from '~/assets/images/products/p4-coriandro.jpg';
import p5 from '~/assets/images/products/p5-romero.jpg';
import p6 from '~/assets/images/products/p6-ajo-en-polvo.jpg';
import p7 from '~/assets/images/products/N-de-Namur.png';

import mainImage from '~/assets/images/general/mainProd.jpg';



const { t } = useTranslations(getLocaleFromUrl(Astro.url));

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  title={t('products.title')}
  subtitle={t('products.subtitle')}  actions={[{ variant: 'primary', target: '_blank', text: 'Comienza a explorar', href: '/' }]}
  image={{
    src: mainImage,
    alt: 'Product',
  }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
  title={t('products.grillaProd.title')}
  subtitle={t('products.grillaProd.subtitle')}
  columns={3}
  items={[
    {
      title: t('products.grillaProd.oregano.title'),
      description:
        'Ofrecemos una variedad de semillas, fertilizantes y productos fitosanitarios de alta calidad para mejorar la productividad de tus cultivos.',
      icon: 'tabler:plant',
      image: p1
    },
    {
      title: t('products.grillaProd.lino.title'),
      description:
        'Incorpora la última tecnología en tu campo con nuestras herramientas y dispositivos diseñados para mejorar la eficiencia y la precisión en la producción agrícola.',
      icon: 'tabler:device-desktop-analytics',
      image: p2

    },
    {
      title: t('products.grillaProd.pasaDeUva.title'),
      description: `Nuestro equipo de expertos está disponible para brindarte orientación personalizada y soluciones adaptadas a las necesidades específicas de tu operación.`,
      icon: 'tabler:headset',
      image: p3

    },
    {
      title: t('products.grillaProd.chia.title'),
      description:
        'Optimiza el uso del agua con nuestros sistemas de riego eficientes y sostenibles, diseñados para maximizar el rendimiento de tus cultivos.',
      icon: 'tabler:droplet',
      image: p4

    },
    {
      title: t('products.grillaProd.sesamo.title'),
      description:
        'Aprovecha nuestros productos orgánicos para promover prácticas agrícolas sostenibles y obtener certificaciones ecológicas.',
      icon: 'tabler:leaf',
      image: p5

    },
    {
      title: t('products.grillaProd.coriandro.title'),
      description:
        'Equipos de última generación que facilitan y agilizan las tareas en el campo, desde la siembra hasta la cosecha.',
      icon: 'tabler:tractor',
      image: p6

    },
    {
      title: t('products.grillaProd.albahaca.title'),
      description:
        'Sistemas integrados para la planificación y monitoreo de cultivos, ayudando a maximizar el rendimiento y minimizar los riesgos.',
      icon: 'tabler:chart-line',
      image: p7

    },
    {
      title: t('products.grillaProd.romero.title'),
      description: `Te ayudamos a implementar prácticas agrícolas sostenibles que respetan el medio ambiente y mejoran la rentabilidad a largo plazo.`,
      icon: 'tabler:recycle',
      image: p7

    },
    {
      title: t('products.grillaProd.proximamente.title'),
      description: t('products.grillaProd.proximamente.description'),
      icon: 'tabler:recycle',
      image: p7

    }
  ]}
/>

  
</Layout>
