---
// Importaciones necesarias
import WidgetWrapper from "~/components/ui/WidgetWrapper.astro";
import Headline from "~/components/ui/Headline.astro";
import ItemGrid2 from "~/components/ui/ItemGrid2.astro";
import type { Features } from "~/types";

// Propiedades
const {
  title = await Astro.slots.render("title"),
  subtitle = await Astro.slots.render("subtitle"),
  tagline = await Astro.slots.render("tagline"),
  map, // Nuevo parámetro opcional
  address = "", // Dirección debajo del mapa
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render("bg"),
} = Astro.props as Features;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`}
  bg={bg}
>
  <!-- Títulos del widget -->
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={classes?.headline}
  />

  <!-- Mapa opcional dentro de una card -->
  {map && (
    <div class="mt-6 w-full max-w-md mx-auto bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="h-80">
        <iframe
          src={map}
          class="w-full h-full border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <!-- Dirección debajo del mapa -->
      {address && (
        <div class="p-4 bg-gray-50">
          <p class="text-gray-700 text-sm text-center">
            {address}
          </p>
        </div>
      )}
    </div>
  )}
</WidgetWrapper>
